{
    "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
    "version": 1,
    "newProjectRoot": "projects",
    "projects": {
        "story-book": {
            "projectType": "library",
            "root": "projects/story-book",
            "sourceRoot": "projects/story-book/src",
            "prefix": "story-book",
            "architect": {
                "build": {
                    "builder": "@storybook/angular:build-storybook",
                    "options": {
                        "configDir": "projects/story-book",
                        "compodoc": true,
                        "compodocArgs": [
                            "-e",
                            "json",
                            "-d",
                            "projects/story-book"
                        ],
                        "styles": [
                            "projects/story-book/src/styles.scss"
                        ],
                        "outputDir": "dist/story-book"
                    }
                },
                "serve": {
                    "builder": "@storybook/angular:start-storybook",
                    "options": {
                        "browserTarget": "story-book:build",
                        "configDir": "projects/story-book",
                        "compodoc": true,
                        "compodocArgs": [
                            "-e",
                            "json",
                            "-d",
                            "projects/story-book"
                        ],
                        "styles": [
                            "projects/story-book/src/styles.scss"
                        ],
                        "port": 6006
                    }
                }
            }
        },
        "core": {
            "projectType": "library",
            "root": "projects/core",
            "sourceRoot": "projects/core",
            "prefix": "core",
            "architect": {
                "build": {
                    "builder": "@angular/build:library",
                    "options": {
                        "tsConfig": "projects/core/tsconfig.lib.json",
                        "outputPath": "dist/ngx-core",
                        "assets": [
                            "projects/core/CHANGELOG.md",
                            {
                                "input": "projects/core/m2/styles",
                                "glob": "**/*",
                                "output": "./m2/styles"
                            }
                        ]
                    },
                    "configurations": {
                        "production": {
                            "tsConfig": "projects/core/tsconfig.lib.prod.json"
                        },
                        "development": {
                            "compilationMode": "full"
                        }
                    },
                    "defaultConfiguration": "production"
                },
                "test": {
                    "builder": "@angular/build:unit-test",
                    "options": {
                        "tsConfig": "projects/core/tsconfig.spec.json"
                    }
                }
            }
        },
