{
    "name": "@hug/ngx-layout",
    "version": "22.0.1-alpha.3",
    "description": "HUG Angular - layout component",
    "homepage": "https://github.com/dsi-hug/ngx-components",
    "license": "GPL-3.0-only",
    "author": "HUG - Hôpitaux Universitaires Genève",
    "contributors": [
        "badisi (https://github.com/badisi)",
        "vapkse (https://github.com/vapkse)"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/dsi-hug/ngx-components.git"
    },
    "keywords": [
        "angular",
        "material",
        "material design",
        "components"
    ],
    "sideEffects": false,
    "exports": {
        "./m2": {
            "sass": "./m2/_layout-theme.scss",
            "default": "./m2/index.ts"
        },
        "./m2/translations/*": {
            "default": "./m2/translations/**/*.json"
        },
        "./translations/*": {
            "default": "./translations/**/*.json"
        },
        ".": "./src/index.ts"
    },
    "scripts": {
        "lint": "eslint . --fix",
        "test": "ng test layout",
        "pretest:ci": "playwright install chromium --only-shell",
        "test:ci": "ng test layout --watch=false",
        "build:ng": "ng build layout -c=production",
        "build": "nx build:ng @hug/ngx-layout --verbose",
        "release": "node -r @swc-node/register ../../scripts/release.ts --projects=@hug/ngx-layout --verbose",
        "release:dry-run": "npm run release -- --dry-run"
    },
    "peerDependencies": {
        "@angular/cdk": ">=22 <23",
        "@angular/common": ">=22 <23",
        "@angular/core": ">=22 <23",
        "@angular/material": ">=22 <23",
        "@hug/ngx-core": "^22.0.0-alpha.6",
        "@hug/ngx-sidenav": "^22.0.1-alpha.1"
    },
    "publishConfig": {
        "access": "public",
        "tag": "alpha"
    }
}
