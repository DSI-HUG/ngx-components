{
    "name": "@hug/ngx-splitter",
    "version": "22.0.0-alpha.4",
    "description": "HUG Angular - splitter component",
    "homepage": "https://github.com/dsi-hug/ngx-components",
    "license": "GPL-3.0-only",
    "author": "HUG - Hôpitaux Universitaires Genève",
    "contributors": [
        "badisi (https://github.com/badisi)",
        "vapkse (https://github.com/vapkse)"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/dsi-hug/ngx-components.git"
    },
    "keywords": [
        "angular",
        "material",
        "material design",
        "components"
    ],
    "sideEffects": false,
    "exports": {
        "./m2": {
            "sass": "./m2/_splitter-theme.scss",
            "default": "./m2/index.ts"
        },
        ".": "./src/index.ts"
    },
    "scripts": {
        "lint": "eslint . --fix",
        "test": "ng test splitter",
        "test:ci": "ng test splitter --watch=false",
        "build:ng": "ng build splitter -c=production",
        "build": "nx build:ng @hug/ngx-splitter --verbose",
        "release": "node -r @swc-node/register ../../scripts/release.ts --projects=@hug/ngx-splitter --verbose",
        "release:dry-run": "npm run release -- --dry-run"
    },
    "peerDependencies": {
        "@angular/cdk": ">=22 <23",
        "@angular/common": ">=22 <23",
        "@angular/core": ">=22 <23",
        "rxjs": "^7.8.2"
    },
    "publishConfig": {
        "access": "public",
        "tag": "alpha"
    }
}
